# Redirect all HTTP traffic to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name sadiqueiqbal.com www.sadiqueiqbal.com;

    return 301 https://$host$request_uri;
}

# HTTPS server block
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sadiqueiqbal.com www.sadiqueiqbal.com;

    root /var/www/sadiqueiqbal/html;
    index index.html index.htm index.nginx-debian.html;

    # SSL Certificate and Key (self-signed)
    ssl_certificate /etc/ssl/self-signed/nginx-selfsigned.crt;
    ssl_certificate_key /etc/ssl/self-signed/nginx-selfsigned.key;
    ssl_dhparam /etc/ssl/certs/dhparam.pem;

    # SSL settings (secure but compatible)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    location / {
        try_files $uri $uri/ =404;
    }
}
